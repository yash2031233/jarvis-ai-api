# For development only. End users enter their key in the app's settings screen
# (stored in the OS keychain). Copy to .env and never commit the real file.

# Brain provider: nvidia | ollama | custom
JARVIS_PROVIDER=nvidia
JARVIS_BASE_URL=https://integrate.api.nvidia.com/v1
JARVIS_API_KEY=nvapi-your-key-here
JARVIS_MODEL=

# Voice engine: auto | gpu | cpu | cloud
JARVIS_VOICE_ENGINE=auto
